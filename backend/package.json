{
  "name": "amrutam-backend",
  "version": "1.0.0",
  "description": "Amrutam Telemedicine backend (NestJS + Prisma + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi:generate": "nest build && node dist/scripts/generate-openapi.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@prisma/client": "6.19.3",
    "@prisma/instrumentation": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "^7.0.9",
    "otplib": "12.0.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.3",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "dotenv": "^16.6.1",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.5.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
